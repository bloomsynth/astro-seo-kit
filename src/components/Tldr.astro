---
/** The short answer at the top of a page; AI assistants quote this. Style `.seo-kit-tldr` in the site. */
interface Props {
  text: string;
  label?: string;
}
const { text, label = 'Quick answer' } = Astro.props;
---

<aside class="seo-kit-tldr" aria-label={label}>
  <p class="seo-kit-tldr-label">{label}</p>
  <p>{text}</p>
</aside>
