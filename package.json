{
  "name": "@bloomsynth/astro-seo-kit",
  "version": "0.1.0",
  "description": "SEO and AI-search plumbing for Astro content sites: frontmatter fields, head tags and JSON-LD, llms.txt, Markdown versions, robots.txt, link attribution and a pre-merge SEO check.",
  "license": "MIT",
  "author": "BloomSynth (https://bloomsynth.com)",
  "homepage": "https://github.com/bloomsynth/astro-seo-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloomsynth/astro-seo-kit.git"
  },
  "bugs": {
    "url": "https://github.com/bloomsynth/astro-seo-kit/issues"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "seo",
    "json-ld",
    "llms.txt",
    "structured-data",
    "ai-search"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./schema": "./src/schema.js",
    "./jsonld": "./src/jsonld.js",
    "./llm": "./src/llm.js",
    "./links": "./src/links.js",
    "./components/*": "./src/components/*",
    "./routes/*": "./src/routes/*"
  },
  "bin": {
    "seo-check": "./bin/seo-check.js"
  },
  "files": [
    "src",
    "bin"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "astro": ">=7"
  },
  "dependencies": {
    "node-html-parser": "^9.0.6"
  },
  "devDependencies": {
    "zod": "^4.6.7"
  }
}
