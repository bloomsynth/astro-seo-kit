{
  "name": "@bloomsynth/astro-seo-kit",
  "version": "0.1.0",
  "description": "Shared SEO and AI-search plumbing for BloomSynth's Astro sites: head tags, JSON-LD, llms.txt, Markdown twins, robots.txt, link attribution and a pre-merge SEO check.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./schema": "./src/schema.js",
    "./jsonld": "./src/jsonld.js",
    "./llm": "./src/llm.js",
    "./links": "./src/links.js",
    "./components/*": "./src/components/*",
    "./routes/*": "./src/routes/*"
  },
  "bin": {
    "seo-check": "./bin/seo-check.js"
  },
  "files": [
    "src",
    "bin"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "astro": ">=6"
  },
  "dependencies": {
    "node-html-parser": "^9.0.6"
  },
  "devDependencies": {
    "zod": "^4.6.7"
  }
}
